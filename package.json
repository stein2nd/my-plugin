{
    "name": "my-plugin",
    "version": "1.0.5",
    "description": "A starter template for custom WordPress plugins. Frontend assets are bundled with Vite.",
    "main": "index.js",
    "scripts": {
        "dev": "vite",
        "build": "node scripts/build.mjs",
        "watch": "node scripts/build.mjs --watch",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "format": "prettier --write .",
        "make-pot": "php -d memory_limit=512M $(which wp) i18n make-pot . languages/my-plugin.pot --include=src --exclude=src/**/node_modules"
    },
    "keywords": [],
    "author": "Koutarou ISHIKAWA",
    "license": "GPL-3.0-or-later",
    "type": "commonjs",
    "dependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.1",
        "@wordpress/block-editor": "^18.0.0",
        "@wordpress/blocks": "^16.1.0",
        "@wordpress/element": "^8.8.0",
        "@wordpress/i18n": "^6.29.0",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "sass": "^1.105.1",
        "stylelint": "^17.16.0",
        "stylelint-scss": "^7.3.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2"
    },
    "allowScripts": {
        "@parcel/watcher": false,
        "fsevents": false
    }
}
